<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2;
    padding-left: 3;
    padding-right: 3;
    padding-top: 3;
    padding-bottom: 3;
    border-width: 0.3;
    border-radius: 4;
  }
  .header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .title {
    font-size: 2.8;
    font-weight: medium;
    text-align: left;
  }
  .fold {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 7;
    height: 7;
    border-width: 0.3;
    border-radius: 3.5;
    cursor: pointer;
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2;
  }
  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 8;
    border-width: 0.3;
    border-radius: 4;
    cursor: pointer;
  }
  .label {
    font-size: 3.2;
    font-weight: medium;
    text-align: center;
  }
  .small {
    font-size: 2.6;
    font-weight: medium;
    text-align: center;
  }
  .row {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 8;
    padding-left: 4;
    padding-right: 4;
    border-width: 0.3;
    border-radius: 4;
    cursor: pointer;
  }
  .year {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 36;
    height: 14;
    border-width: 0.3;
    border-radius: 7;
  }
  .year-text {
    font-size: 9;
    font-weight: light;
    text-align: center;
  }
  .chips {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 2;
    width: 90;
  }
  .chip {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 9;
    height: 7;
    border-width: 0.3;
    border-radius: 3.5;
    cursor: pointer;
  }
  .actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 2;
    width: 90;
  }
</style>
<div id="bar-root" class="panel" style="width: 96;">
  <div id="year-root" class="year"><span id="year-text" class="year-text">2025</span></div>
  <div id="years-root" class="chips">
      <div id="year-chip-0" class="chip"><span id="year-chip-label-0" class="small">2020</span></div>
      <div id="year-chip-1" class="chip"><span id="year-chip-label-1" class="small">2020</span></div>
      <div id="year-chip-2" class="chip"><span id="year-chip-label-2" class="small">2020</span></div>
      <div id="year-chip-3" class="chip"><span id="year-chip-label-3" class="small">2020</span></div>
      <div id="year-chip-4" class="chip"><span id="year-chip-label-4" class="small">2020</span></div>
      <div id="year-chip-5" class="chip"><span id="year-chip-label-5" class="small">2020</span></div>
      <div id="year-chip-6" class="chip"><span id="year-chip-label-6" class="small">2020</span></div>
      <div id="year-chip-7" class="chip"><span id="year-chip-label-7" class="small">2020</span></div>
  </div>
  <div class="actions">
    <div id="map-btn" class="btn" style="width: 22;"><span id="map-btn-label" class="label">MAP</span></div>
    <div id="time-btn" class="btn" style="width: 40;"><span id="time-btn-label" class="label">TIME MACHINE</span></div>
    <div id="portal-btn" class="btn" style="width: 22;"><span id="portal-btn-label" class="label">PORTAL</span></div>
  </div>
</div>
