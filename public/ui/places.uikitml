<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2;
    padding-left: 3;
    padding-right: 3;
    padding-top: 3;
    padding-bottom: 3;
    border-width: 0.3;
    border-radius: 4;
  }
  .header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .title {
    font-size: 2.8;
    font-weight: bold;
    text-align: left;
  }
  .fold {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 7;
    height: 7;
    border-width: 0.3;
    border-radius: 3.5;
    cursor: pointer;
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2;
  }
  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 8;
    border-width: 0.3;
    border-radius: 4;
    cursor: pointer;
  }
  .label {
    font-size: 3.2;
    font-weight: medium;
    text-align: center;
  }
  .small {
    font-size: 2.6;
    font-weight: medium;
    text-align: center;
  }
  .row {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 8;
    padding-left: 4;
    padding-right: 4;
    border-width: 0.3;
    border-radius: 4;
    cursor: pointer;
  }
.icon {
    width: 4;
    height: 4;
  }
</style>
<div id="places-root" class="panel" style="width: 62;">
  <div class="header" style="width: 56;">
    <span id="places-title" class="title">PLACES WITH PAST IMAGERY</span>
    <div id="places-fold" class="fold"><svg id="places-fold-icon" class="icon"></svg></div>
  </div>
  <div id="places-content" class="content">
    <div id="place-row-0" class="row" style="width: 56;">
      <span id="place-name-0" class="label">Place</span>
      <span id="place-years-0" class="small">2016-2025</span>
    </div>
    <div id="place-row-1" class="row" style="width: 56;">
      <span id="place-name-1" class="label">Place</span>
      <span id="place-years-1" class="small">2016-2025</span>
    </div>
    <div id="place-row-2" class="row" style="width: 56;">
      <span id="place-name-2" class="label">Place</span>
      <span id="place-years-2" class="small">2016-2025</span>
    </div>
    <div id="place-row-3" class="row" style="width: 56;">
      <span id="place-name-3" class="label">Place</span>
      <span id="place-years-3" class="small">2016-2025</span>
    </div>
    <div id="place-row-4" class="row" style="width: 56;">
      <span id="place-name-4" class="label">Place</span>
      <span id="place-years-4" class="small">2016-2025</span>
    </div>
    <div id="places-pager" class="header" style="width: 56;">
      <div id="places-prev" class="btn" style="width: 10;"><svg id="places-prev-icon" class="icon"></svg></div>
      <span id="places-page" class="small">1 / 1</span>
      <div id="places-next" class="btn" style="width: 10;"><svg id="places-next-icon" class="icon"></svg></div>
    </div>
  </div>
</div>
