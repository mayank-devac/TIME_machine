<div id="search-root" style="display: flex; flex-direction: column; align-items: center; gap: 2; padding: 3; width: 64; background-color: #0f121c99; border-color: #ffffff38; border-width: 0.3; border-radius: 6;">
  <span id="search-title" style="font-size: 2.8; font-weight: medium; color: #ffffffcc;">SEARCH A PLACE</span>
  <div style="display: flex; flex-direction: row; align-items: center; gap: 1.5; width: 58;">
    <div id="search-box" style="display: flex; flex-direction: row; align-items: center; width: 38; height: 8; padding-left: 3; background-color: #ffffff14; border-color: #ffffff38; border-width: 0.3; border-radius: 4;">
      <span id="search-text" style="font-size: 3; font-weight: medium; color: #ffffff;">Type or speak a place</span>
    </div>
    <div id="search-mic" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 9; height: 8; background-color: #7c6cff59; border-color: #ffffff38; border-width: 0.3; border-radius: 4; cursor: pointer;"><span id="search-mic-label" style="font-size: 2.6; font-weight: medium; color: #ffffff; text-align: center;">MIC</span></div>
    <div id="search-clear" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 8; height: 8; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 4; cursor: pointer;"><span id="search-clear-label" style="font-size: 3.4; font-weight: medium; color: #ffffff; text-align: center;">X</span></div>
  </div>
  <span id="search-status" style="font-size: 2.6; font-weight: medium; color: #ffffffa6; text-align: center;">Pick a place name, then ENTER.</span>
  <div id="search-row-0" style="display: none; flex-direction: row; align-items: center; justify-content: flex-start; width: 58; height: 7.5; padding-left: 4; padding-right: 4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 3.75; cursor: pointer;">
    <span id="search-row-label-0" style="font-size: 2.9; font-weight: medium; color: #ffffff;">Result</span>
  </div>
  <div id="search-row-1" style="display: none; flex-direction: row; align-items: center; justify-content: flex-start; width: 58; height: 7.5; padding-left: 4; padding-right: 4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 3.75; cursor: pointer;">
    <span id="search-row-label-1" style="font-size: 2.9; font-weight: medium; color: #ffffff;">Result</span>
  </div>
  <div id="search-row-2" style="display: none; flex-direction: row; align-items: center; justify-content: flex-start; width: 58; height: 7.5; padding-left: 4; padding-right: 4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 3.75; cursor: pointer;">
    <span id="search-row-label-2" style="font-size: 2.9; font-weight: medium; color: #ffffff;">Result</span>
  </div>
  <div style="display: flex; flex-direction: column; align-items: center; gap: 1;">
    <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 1;">
