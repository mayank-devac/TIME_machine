    <div id="search-use" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 15; height: 7; background-color: #2ee6d659; border-color: #ffffff38; border-width: 0.3; border-radius: 3.5; cursor: pointer;"><span id="search-use-label" style="font-size: 2.8; font-weight: medium; color: #ffffff; text-align: center;">USE</span></div>
