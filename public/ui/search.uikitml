      <div id="search-key-P" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-P" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">P</span></div>
    </div>
