<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2;
    padding-left: 3;
    padding-right: 3;
    padding-top: 3;
    padding-bottom: 3;
    border-width: 0.3;
    border-radius: 4;
  }
  .header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .title {
    font-size: 2.8;
    font-weight: bold;
    text-align: left;
  }
  .fold {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 7;
    height: 7;
    border-width: 0.3;
    border-radius: 3.5;
    cursor: pointer;
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2;
  }
  .btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 8;
    border-width: 0.3;
    border-radius: 4;
    cursor: pointer;
  }
  .label {
    font-size: 3.2;
    font-weight: medium;
    text-align: center;
  }
  .small {
    font-size: 2.6;
    font-weight: medium;
    text-align: center;
  }
  .row {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 8;
    padding-left: 4;
    padding-right: 4;
    border-width: 0.3;
    border-radius: 4;
    cursor: pointer;
  }
  .keys {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1;
  }
  .key {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 5.4;
    height: 6.4;
    border-width: 0.3;
    border-radius: 2;
    cursor: pointer;
  }
  .input {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 34;
    height: 8;
    padding-left: 3;
    border-width: 0.3;
    border-radius: 4;
  }
  .line {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 58;
  }
.icon {
    width: 4;
    height: 4;
  }
</style>
<div id="search-root" class="panel" style="width: 64;">
  <div class="header" style="width: 58;">
    <span id="search-title" class="title">SEARCH A PLACE</span>
    <div id="search-fold" class="fold"><svg id="search-fold-icon" class="icon"></svg></div>
  </div>
  <div id="search-content" class="content">
    <div class="line">
      <div id="search-box" class="input"><span id="search-text" class="small">Type or speak a place</span></div>
      <div id="search-mic" class="btn" style="width: 12;"><svg id="search-mic-icon" class="icon"></svg></div>
      <div id="search-clear" class="btn" style="width: 9;"><svg id="search-clear-icon" class="icon"></svg></div>
    </div>
    <span id="search-status" class="small">Type a place name, then SEARCH.</span>
    <div id="search-row-0" class="row" style="width: 58; justify-content: flex-start;">
      <span id="search-row-label-0" class="label">Result</span>
    </div>
    <div id="search-row-1" class="row" style="width: 58; justify-content: flex-start;">
      <span id="search-row-label-1" class="label">Result</span>
    </div>
    <div id="search-row-2" class="row" style="width: 58; justify-content: flex-start;">
      <span id="search-row-label-2" class="label">Result</span>
    </div>
    <div class="content" style="gap: 1;">
      <div class="keys">
        <div id="search-key-Q" class="key"><span id="search-key-label-Q" class="label">Q</span></div>
        <div id="search-key-W" class="key"><span id="search-key-label-W" class="label">W</span></div>
        <div id="search-key-E" class="key"><span id="search-key-label-E" class="label">E</span></div>
        <div id="search-key-R" class="key"><span id="search-key-label-R" class="label">R</span></div>
        <div id="search-key-T" class="key"><span id="search-key-label-T" class="label">T</span></div>
        <div id="search-key-Y" class="key"><span id="search-key-label-Y" class="label">Y</span></div>
        <div id="search-key-U" class="key"><span id="search-key-label-U" class="label">U</span></div>
        <div id="search-key-I" class="key"><span id="search-key-label-I" class="label">I</span></div>
        <div id="search-key-O" class="key"><span id="search-key-label-O" class="label">O</span></div>
        <div id="search-key-P" class="key"><span id="search-key-label-P" class="label">P</span></div>
      </div>
      <div class="keys">
        <div id="search-key-A" class="key"><span id="search-key-label-A" class="label">A</span></div>
        <div id="search-key-S" class="key"><span id="search-key-label-S" class="label">S</span></div>
        <div id="search-key-D" class="key"><span id="search-key-label-D" class="label">D</span></div>
        <div id="search-key-F" class="key"><span id="search-key-label-F" class="label">F</span></div>
        <div id="search-key-G" class="key"><span id="search-key-label-G" class="label">G</span></div>
        <div id="search-key-H" class="key"><span id="search-key-label-H" class="label">H</span></div>
        <div id="search-key-J" class="key"><span id="search-key-label-J" class="label">J</span></div>
        <div id="search-key-K" class="key"><span id="search-key-label-K" class="label">K</span></div>
        <div id="search-key-L" class="key"><span id="search-key-label-L" class="label">L</span></div>
      </div>
      <div class="keys">
        <div id="search-key-Z" class="key"><span id="search-key-label-Z" class="label">Z</span></div>
        <div id="search-key-X" class="key"><span id="search-key-label-X" class="label">X</span></div>
        <div id="search-key-C" class="key"><span id="search-key-label-C" class="label">C</span></div>
        <div id="search-key-V" class="key"><span id="search-key-label-V" class="label">V</span></div>
        <div id="search-key-B" class="key"><span id="search-key-label-B" class="label">B</span></div>
        <div id="search-key-N" class="key"><span id="search-key-label-N" class="label">N</span></div>
        <div id="search-key-M" class="key"><span id="search-key-label-M" class="label">M</span></div>
        <div id="search-key-BACK" class="key" style="width: 11;"><svg id="search-key-icon-BACK" class="icon"></svg></div>
      </div>
    </div>
    <div class="line">
      <div id="search-space" class="btn" style="width: 34;"><svg id="search-space-icon" class="icon"></svg></div>
      <div id="search-enter" class="btn" style="width: 22;"><svg id="search-enter-icon" class="icon"></svg></div>
    </div>
  </div>
</div>
