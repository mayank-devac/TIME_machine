      <div id="search-key-C" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-C" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">C</span></div>
      <div id="search-key-V" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-V" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">V</span></div>
      <div id="search-key-B" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-B" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">B</span></div>
      <div id="search-key-N" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-N" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">N</span></div>
      <div id="search-key-M" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-M" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">M</span></div>
      <div id="search-key-BACK" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 11; height: 6.4; background-color: #ffffff33; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-BACK" style="font-size: 2.6; font-weight: medium; color: #ffffff; text-align: center;">DEL</span></div>
    </div>
  </div>
  <div style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 1.5; width: 58;">
