      <div id="search-key-U" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-U" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">U</span></div>
      <div id="search-key-I" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-I" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">I</span></div>
