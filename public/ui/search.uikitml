      <div id="search-key-F" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-F" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">F</span></div>
      <div id="search-key-G" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-G" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">G</span></div>
      <div id="search-key-H" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-H" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">H</span></div>
      <div id="search-key-J" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-J" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">J</span></div>
      <div id="search-key-K" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-K" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">K</span></div>
      <div id="search-key-L" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-L" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">L</span></div>
    </div>
