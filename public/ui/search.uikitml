      <div id="search-key-S" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-S" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">S</span></div>
