      <div id="search-key-R" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-R" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">R</span></div>
      <div id="search-key-T" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 5.4; height: 6.4; background-color: #ffffff1f; border-color: #ffffff38; border-width: 0.3; border-radius: 2; cursor: pointer;"><span id="search-key-label-T" style="font-size: 3; font-weight: medium; color: #ffffff; text-align: center;">T</span></div>
